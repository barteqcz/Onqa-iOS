    "No internet connection. Connect to the internet and try again.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма падключэння да інтэрнэту. Падключыцеся да інтэрнэту і паспрабуйце зноў."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Connect to the internet and try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма интернет връзка. Свържете се с интернет и опитайте отново."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema internetske veze. Povežite se na internet i pokušajte ponovo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není k dispozici připojení k internetu. Připojte se k internetu a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen internetforbindelse. Opret forbindelse til internettet, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung. Stelle eine Internetverbindung her und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει σύνδεση στο διαδίκτυο. Συνδεθείτε και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay conexión a internet. Conéctate e inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetiühendus puudub. Loo internetiühendus ja proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet-yhteyttä ei ole. Yhdistä internetiin ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune connexion Internet. Connectez-vous à Internet et réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl aon nasc idirlín ann. Ceangail leis an idirlíon agus bain triail eile as."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema internetske veze. Povežite se na internet i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs internetkapcsolat. Kapcsolódj az internethez, majd próbáld újra."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin nettenging. Tengdu tækið við internetið og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione Internet. Connettiti a Internet e riprova."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Keng Internetverbindung. Stell eng Internetverbindung hier a probéier et nach eng Kéier."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nėra interneto ryšio. Prisijunkite prie interneto ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav interneta savienojuma. Izveido savienojumu ar internetu un mēģini vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема интернет-врска. Поврзете се на интернет и обидете се повторно."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "M'hemmx konnessjoni tal-internet. Ikkonnettja mal-internet u erġa' pprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen internettforbindelse. Koble til internett og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen internetverbinding. Maak verbinding met internet en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia z internetem. Połącz się z internetem i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ligação à Internet. Liga-te à Internet e tenta novamente."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagina connexiun d'internet. Connecta cun l'internet e emprova danovamain."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există conexiune la internet. Conectează-te la internet și încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie je k dispozícii internetové pripojenie. Pripojte sa na internet a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni internetne povezave. Povežite se z internetom in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk ka lidhje interneti. Lidhu me internetin dhe provo përsëri."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема интернет везе. Повежите се на интернет и покушајте поново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen internetanslutning. Anslut till internet och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet bağlantısı yok. İnternete bağlanıp yeniden dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає підключення до інтернету. Підключіться до інтернету й повторіть спробу."
          }
        }
      }
    },
