    "Auto mode requires location access. Choose a location manually to use the app without it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto mode requires location access. Choose a location manually to use the app without it."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для аўтаматычнага рэжыму патрэбны доступ да месцазнаходжання. Выберыце месца ўручную, каб карыстацца праграмай без доступу."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичният режим изисква достъп до местоположението. Изберете местоположение ръчно, за да използвате приложението без достъп."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski način rada zahtijeva pristup lokaciji. Odaberite lokaciju ručno da biste koristili aplikaciju bez pristupa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatický režim vyžaduje přístup k poloze. Vyberte polohu ručně, abyste mohli aplikaci používat bez přístupu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk tilstand kræver adgang til lokalitet. Vælg en placering manuelt for at bruge appen uden adgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Automatikmodus benötigt Standortzugriff. Wähle einen Standort manuell, um die App ohne Zugriff zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αυτόματη λειτουργία απαιτεί πρόσβαση στην τοποθεσία. Επιλέξτε τοποθεσία χειροκίνητα για να χρησιμοποιείτε την εφαρμογή χωρίς πρόσβαση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo automático requiere acceso a la ubicación. Elige una ubicación manualmente para usar la app sin acceso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaatrežiim vajab juurdepääsu asukohale. Vali asukoht käsitsi, et rakendust ilma juurdepääsuta kasutada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen tila vaatii sijaintioikeuden. Valitse sijainti manuaalisesti, jos haluat käyttää sovellusta ilman sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode automatique nécessite l'accès à la position. Choisissez une position manuellement pour utiliser l'app sans cet accès."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Teastaíonn rochtain ar shuíomh don mhód uathoibríoch. Roghnaigh suíomh de láimh chun an app a úsáid gan rochtain."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski način rada zahtijeva pristup lokaciji. Odaberite lokaciju ručno da biste koristili aplikaciju bez pristupa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az automatikus módhoz helyhozzáférés szükséges. Válassz helyet kézzel, hogy hozzáférés nélkül is használhasd az alkalmazást."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjálfvirk stilling krefst aðgangs að staðsetningu. Veldu staðsetningu handvirkt til að nota appið án aðgangs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità automatica richiede l'accesso alla posizione. Scegli una posizione manualmente per usare l'app senza accesso."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den automateschen Modus brauch Zougrëff op de Standuert. Wielt de Standuert manuell, fir d'App ouni Zougrëff ze benotzen."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiniam režimui reikia prieigos prie vietos. Pasirinkite vietą rankiniu būdu, kad galėtumėte naudoti programėlę be prieigos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automātiskajam režīmam nepieciešama piekļuve atrašanās vietai. Izvēlieties atrašanās vietu manuāli, lai lietotu lietotni bez piekļuves."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматскиот режим бара пристап до локацијата. Изберете локација рачно за да ја користите апликацијата без пристап."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
