    "Tap to play. Touch and hold to add or remove from favorites.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсніце, каб прайграць. Націсніце і ўтрымлівайце, каб дадаць у абранае або выдаліць з яго."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to play. Touch and hold to add or remove from favorites."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете за възпроизвеждане. Докоснете и задръжте, за да добавите или премахнете от любими."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite za reprodukciju. Dodirnite i zadržite da dodate ili uklonite iz omiljenih."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím spustíte přehrávání. Podržením přidáte stanici k oblíbeným nebo ji odeberete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at afspille. Tryk og hold for at føje til eller fjerne fra favoritter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Abspielen tippen. Gedrückt halten, um Sender zu den Favoriten hinzuzufügen oder daraus zu entfernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε για αναπαραγωγή. Πατήστε παρατεταμένα για προσθήκη ή αφαίρεση από τα αγαπημένα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para reproducir. Mantén pulsado para añadir a favoritos o quitar de ellos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Esitamiseks puuduta. Lemmikutesse lisamiseks või sealt eemaldamiseks puuduta ja hoia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita toisto napauttamalla. Lisää suosikkeihin tai poista suosikeista painamalla pitkään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour lire. Maintenez le doigt appuyé pour ajouter aux favoris ou les retirer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapáil chun seinm. Brúigh agus coinnigh chun cur le ceanáin nó baint astu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite za reprodukciju. Dodirnite i držite za dodavanje ili uklanjanje iz favorita."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejátszáshoz koppints. A kedvencekhez adáshoz vagy eltávolításhoz tartsd nyomva."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu til að spila. Haltu inni til að bæta við eða fjarlægja úr eftirlæti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per riprodurre. Tieni premuto per aggiungere ai preferiti o rimuovere dai preferiti."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen fir ofzespillen. Gedréckt halen, fir zu de Favoritten derbäizesetzen oder ewechzehuelen."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite, kad paleistumėte. Palaikykite, kad pridėtumėte prie mėgstamiausių arba pašalintumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskaries, lai atskaņotu. Turi nospiestu, lai pievienotu izlasei vai noņemtu no tās."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допрете за репродукција. Притиснете и задржете за додавање или отстранување од омилени."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tektek biex iddoqq. Agħfas u żomm biex iżżid mal-favoriti jew tneħħi minnhom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å spille av. Trykk og hold for å legge til eller fjerne fra favoritter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om af te spelen. Houd ingedrukt om toe te voegen aan of te verwijderen uit favorieten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij, aby odtworzyć. Naciśnij i przytrzymaj, aby dodać do ulubionych lub usunąć z nich."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para reproduzir. Mantém premido para adicionar aos favoritos ou removê-los."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per sunar. Tegna premì per agiuntar als favurits u per allontanar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pentru redare. Ține apăsat pentru a adăuga sau elimina din favorite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím spustíte prehrávanie. Podržaním pridáte do obľúbených alebo odstránite z obľúbených."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite za predvajanje. Pritisnite in pridržite, da dodate med priljubljene ali odstranite iz njih."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Prek për të luajtur. Mbaj shtypur për të shtuar te të preferuarat ose për ta hequr."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додирните за репродукцију. Додирните и задржите да додате у омиљене или уклоните из њих."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att spela upp. Håll ned för att lägga till i eller ta bort från favoriter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalmak için dokun. Favorilere eklemek veya favorilerden çıkarmak için basılı tut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться, щоб відтворити. Натисніть і утримуйте, щоб додати до обраного або вилучити звідти."
          }
        }
      }
    },
