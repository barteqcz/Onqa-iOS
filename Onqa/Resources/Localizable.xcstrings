        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez piekļuves atrašanās vietai var izmantot tikai manuālo režīmu. Izvēlieties atrašanās vietu iestatījumos."
          }
        },
        "mk": {
          "stringUnit": {
