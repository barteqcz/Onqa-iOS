    "This can take a while on a slow connection. Stations will appear as soon as it finishes.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры павольным злучэнні гэта можа заняць некаторы час. Станцыі з’явяцца, як толькі спампоўка завершыцца."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can take a while on a slow connection. Stations will appear as soon as it finishes."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "При бавна връзка това може да отнеме известно време. Станциите ще се появят веднага щом приключи."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na sporoj vezi ovo može potrajati. Stanice će se pojaviti čim se preuzimanje završi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při pomalém připojení to může chvíli trvat. Stanice se objeví, jakmile stahování skončí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan tage et stykke tid på en langsom forbindelse. Stationerne vises, så snart det er færdigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einer langsamen Verbindung kann das etwas dauern. Die Sender erscheinen, sobald der Download abgeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με αργή σύνδεση αυτό μπορεί να διαρκέσει λίγο. Οι σταθμοί θα εμφανιστούν μόλις ολοκληρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una conexión lenta puede tardar un poco. Las emisoras aparecerán en cuanto termine."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aeglase ühenduse korral võib see veidi aega võtta. Jaamad ilmuvad kohe, kui allalaadimine on lõppenud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitaalla yhteydellä tämä voi kestää hetken. Asemat ilmestyvät heti, kun lataus on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une connexion lente, cela peut prendre un moment. Les stations apparaîtront dès que ce sera terminé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Má tá do nasc mall, féadfaidh sé seo tamall a thógáil. Beidh na stáisiúin le feiceáil a luaithe a chríochnaíonn sé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na sporoj vezi ovo može potrajati. Postaje će se pojaviti čim se preuzimanje završi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassú kapcsolat esetén ez eltarthat egy ideig. Az állomások megjelennek, amint a letöltés befejeződik."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Á hægri tengingu getur þetta tekið smá stund. Stöðvarnar birtast um leið og niðurhalinu lýkur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una connessione lenta potrebbe volerci un po’. Le stazioni appariranno non appena il download sarà terminato."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei enger lueseger Verbindung kann dat e bëssen dauere. D’Statioune erschéngen, soubal et fäerdeg ass."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esant lėtam ryšiui tai gali užtrukti. Stotys atsiras, kai tik atsisiuntimas baigsis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar lēnu savienojumu tas var aizņemt kādu laiku. Stacijas parādīsies, tiklīdz lejupielāde būs pabeigta."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "При бавна врска ова може да потрае. Станиците ќе се појават штом ќе заврши."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "B’konnessjoni bil-mod dan jista’ jieħu ftit żmien. L-istazzjonijiet jidhru malli jintemm."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På en tregere tilkobling kan dette ta litt tid. Stasjonene vises så snart nedlastingen er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij een trage verbinding kan dit even duren. De zenders verschijnen zodra het klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy wolnym połączeniu może to chwilę potrwać. Stacje pojawią się, gdy tylko pobieranie się zakończy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma ligação lenta, isto pode demorar algum tempo. As estações aparecerão assim que terminar."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar ina colliaziun lenta po quai durar in mument. Las staziuns cumparan uschespert che la telechargia è terminada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La o conexiune lentă, acest lucru poate dura ceva timp. Posturile vor apărea imediat ce se termină."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri pomalom pripojení to môže chvíľu trvať. Stanice sa zobrazia hneď po dokončení sťahovania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri počasni povezavi lahko to traja nekaj časa. Postaje se bodo prikazale takoj, ko bo prenos končan."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Me një lidhje të ngadaltë kjo mund të zgjasë pak. Stacionet do të shfaqen sapo të përfundojë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "На спорој вези ово може потрајати. Станице ће се појавити чим се преузимање заврши."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en långsam anslutning kan det ta en stund. Stationerna visas så snart hämtningen är klar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş bir bağlantıda bu biraz zaman alabilir. İstasyonlar, indirme biter bitmez görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За повільного з’єднання це може тривати деякий час. Станції з’являться, щойно завантаження завершиться."
          }
        }
      }
    },
    "Onqa needs to download its radio catalog once. Connect to the internet and the download will start automatically.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa неабходна адзін раз спампаваць свой радыёкаталог. Падключыцеся да інтэрнэту, і спампоўка пачнецца аўтаматычна."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa needs to download its radio catalog once. Connect to the internet and the download will start automatically."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa трябва да изтегли радиокаталога си веднъж. Свържете се с интернет и изтеглянето ще започне автоматично."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa mora jednom preuzeti svoj radio katalog. Povežite se na internet i preuzimanje će započeti automatski."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa si musí jednou stáhnout svůj katalog rádií. Připojte se k internetu a stahování se spustí automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa skal downloade sit radiokatalog én gang. Opret forbindelse til internettet, så starter overførslen automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa muss seinen Radiokatalog einmalig herunterladen. Stelle eine Internetverbindung her, dann startet der Download automatisch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Onqa πρέπει να κατεβάσει τον κατάλογο ραδιοφώνου του μία φορά. Συνδεθείτε στο διαδίκτυο και η λήψη θα ξεκινήσει αυτόματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa necesita descargar su catálogo de radio una vez. Conéctate a internet y la descarga comenzará automáticamente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa peab oma raadiokataloogi ühe korra alla laadima. Looge internetiühendus ja allalaadimine algab automaatselt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqan täytyy ladata radioluettelonsa kerran. Muodosta internetyhteys, niin lataus alkaa automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa doit télécharger son catalogue radio une seule fois. Connectez-vous à Internet et le téléchargement démarrera automatiquement."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Caithfidh Onqa a chatalóg raidió a íoslódáil uair amháin. Ceangail leis an idirlíon agus tosóidh an íoslódáil go huathoibríoch."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa mora jednom preuzeti svoj radijski katalog. Povežite se na internet i preuzimanje će započeti automatski."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Onqának egyszer le kell töltenie a rádiókatalógusát. Csatlakozz az internethez, és a letöltés automatikusan elindul."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa þarf að sækja útvarpsskrána sína einu sinni. Tengstu við internetið og niðurhalið hefst sjálfkrafa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa deve scaricare il suo catalogo radio una sola volta. Collegati a internet e il download partirà automaticamente."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa muss säi Radio-Katalog eemol erofluede. Verbann dech mam Internet an den Download fänkt automatesch un."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Onqa“ turi vieną kartą atsisiųsti savo radijo katalogą. Prisijunkite prie interneto ir atsisiuntimas prasidės automatiškai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotnei Onqa vienreiz jālejupielādē savs radio katalogs. Izveidojiet savienojumu ar internetu, un lejupielāde sāksies automātiski."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa треба еднаш да го преземе својот радио каталог. Поврзете се на интернет и преземањето ќе започне автоматски."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa jeħtieġ iniżżel il-katalgu tar-radju tiegħu darba. Qabbad mal-internet u t-tniżżil jibda awtomatikament."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa må laste ned radiokatalogen sin én gang. Koble til internett, så starter nedlastingen automatisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa moet zijn radiocatalogus één keer downloaden. Maak verbinding met internet en de download start automatisch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa musi raz pobrać swój katalog radiowy. Połącz się z internetem, a pobieranie rozpocznie się automatycznie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Onqa precisa de transferir o seu catálogo de rádio uma vez. Ligue-se à internet e a transferência começará automaticamente."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa sto telechargiar ina giada ses catalog da radio. Colliescha tai cun l’internet e la telechargia cumenza automaticamain."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa trebuie să descarce o singură dată catalogul radio. Conectează-te la internet și descărcarea va începe automat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa si musí raz stiahnuť svoj rádiový katalóg. Pripojte sa na internet a sťahovanie sa spustí automaticky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa mora enkrat prenesti svoj radijski katalog. Povežite se z internetom in prenos se bo samodejno začel."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa duhet ta shkarkojë një herë katalogun e radios. Lidhu me internetin dhe shkarkimi do të nisë automatikisht."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa мора једном да преузме свој радио-каталог. Повежите се на интернет и преузимање ће почети аутоматски."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa behöver hämta sin radiokatalog en gång. Anslut till internet så startar hämtningen automatiskt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa’nın radyo kataloğunu bir kez indirmesi gerekiyor. İnternete bağlanın, indirme otomatik olarak başlayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Onqa потрібно один раз завантажити свій радіокаталог. Підключіться до інтернету, і завантаження почнеться автоматично."
          }
        }
      }
    },
    "Without location access, you can use Manual mode only. Choose your location in Settings.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Без доступу да месцазнаходжання даступны толькі ручны рэжым. Выберыце месца ў наладах."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without location access, you can use Manual mode only. Choose your location in Settings."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без достъп до местоположението е достъпен само ръчен режим. Изберете местоположение в Настройки."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez pristupa lokaciji dostupan je samo ručni način. Odaberite lokaciju u Postavkama."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez přístupu k poloze je dostupný pouze ruční režim. Vyberte polohu v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden adgang til lokalitet kan du kun bruge manuel tilstand. Vælg din placering i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Standortzugriff kannst du nur den manuellen Modus nutzen. Wähle deinen Standort in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς πρόσβαση στην τοποθεσία, μπορείτε να χρησιμοποιήσετε μόνο τη χειροκίνητη λειτουργία. Επιλέξτε τοποθεσία στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a la ubicación, solo puedes usar el modo manual. Elige tu ubicación en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilma asukohajuurdepääsuta saad kasutada ainult käsitsi režiimi. Vali asukoht seadetes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman sijaintioikeutta voit käyttää vain manuaalista tilaa. Valitse sijainti asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans accès à la position, seul le mode manuel est disponible. Choisissez votre position dans Réglages."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Gan rochtain ar shuíomh, ní féidir leat ach an mód láimhe a úsáid. Roghnaigh do shuíomh sna Socruithe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez pristupa lokaciji dostupan je samo ručni način rada. Odaberite lokaciju u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyhozzáférés nélkül csak a kézi mód használható. Válassz helyet a Beállításokban."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Án aðgangs að staðsetningu geturðu aðeins notað handvirka stillingu. Veldu staðsetningu í Stillingum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza accesso alla posizione puoi usare solo la modalità manuale. Scegli la posizione nelle Impostazioni."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouni Zougrëff op de Standuert kanns du nëmmen de manuelle Modus benotzen. Wielt äre Standuert an den Astellungen."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neturint prieigos prie vietos galima naudoti tik rankinį režimą. Pasirinkite vietą nustatymuose."
