          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza access a la posiziun pos ti utilisar mo il modus manual. Tscherna tia posiziun en las configuraziuns."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără acces la locație poți folosi doar modul manual. Alege locația din Setări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez prístupu k polohe môžete používať iba manuálny režim. Vyberte polohu v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez dostopa do lokacije lahko uporabljate samo ročni način. Izberite lokacijo v nastavitvah."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pa qasje te vendndodhja mund të përdorësh vetëm mënyrën manuale. Zgjidh vendndodhjen te Cilësimet."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без приступа локацији можете користити само ручни режим. Изаберите локацију у Подешавањима."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan platsåtkomst kan du bara använda manuellt läge. Välj din plats i Inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum erişimi olmadan yalnızca manuel modu kullanabilirsiniz. Konumunuzu Ayarlar'dan seçin."
